# =============================================================================
# NemoGuard Pipeline Copilot — Environment Configuration
# Copy this file to `.env` in the same directory (pipeline-copilot/) and fill
# in real values. NEVER commit the resulting `.env` file (it is gitignored).
# =============================================================================

# --- NVIDIA NIM / Nemotron Inference ---
# Get a key at https://build.nvidia.com/ (NVIDIA API Catalog).
# Required by: api, temporal-worker, simulator services.
NVIDIA_API_KEY=nvapi-REPLACE_ME

# --- Auth ---
# Used to sign/verify JWTs (src/api/auth.py). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required by: api, temporal-worker services.
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

# --- Environment ---
# "development" enables the mock-login endpoint and verbose errors.
# "production" disables mock-login and returns generic error responses.
ENV=development

# --- Database (defaults match docker-compose.yml; override for external DB) ---
# POSTGRES_URL=postgresql://nemoguard:nemoguard_password@postgres:5432/nemoguard_db

# --- Temporal (defaults match docker-compose.yml) ---
# TEMPORAL_URL=temporal:7233

# --- Webhook signature verification (optional, per-source) ---
# /api/v2/ingest/webhook is intentionally reachable without a NemoGuard JWT
# (real monitoring systems like Datadog/PagerDuty/CloudWatch can't easily be
# issued one), but any source you configure a secret for here MUST then
# present a valid HMAC-SHA256 signature (computed as
# HMAC-SHA256(secret, raw_request_body)) in the
# "X-NemoGuard-Signature: sha256=<hex>" header, or its requests are rejected
# with 401. Sources with no configured secret remain open (this is an
# opt-in, per-source authentication model -- see src/api/webhook_security.py).
#
# Naming: WEBHOOK_SECRET_<SOURCE>, where <SOURCE> is the payload's "source"
# (or "source_system") field, uppercased with non-alphanumeric characters
# replaced by underscores. Examples:
#   source="datadog"     -> WEBHOOK_SECRET_DATADOG
#   source="pager-duty"  -> WEBHOOK_SECRET_PAGER_DUTY
# WEBHOOK_SECRET_DATADOG=REPLACE_ME_IF_YOU_WANT_TO_AUTHENTICATE_THIS_SOURCE
