# Use Docker's official CLI-only image as a build stage. Debian's `docker.io`
# package was verified live to claim installation while leaving no usable
# `/usr/bin/docker` binary in this python:3.10-slim image.
FROM docker:27-cli AS docker-cli

FROM python:3.10-slim

WORKDIR /app

# Build context is the repo root (see docker-compose.yml) so this image can
# also bundle localstack_lab/ -- the simulator's new /lab/* endpoints reuse
# its aws_clients.py factory and its exact bucket/function/queue naming
# conventions instead of re-implementing (and inevitably drifting from) a
# second copy of that logic.
COPY simulator_backend/ ./
COPY localstack_lab/ ./localstack_lab/

RUN pip install --no-cache-dir fastapi uvicorn pydantic httpx psycopg2-binary openai "boto3==1.34.144" "botocore==1.34.144"

# Copies Docker's official, known-good CLI client only (not a daemon). It
# talks to the HOST's Docker daemon through the socket mounted in
# docker-compose.yml. This lets main.py's _lab_auto_provision_loop run
# provision.py's required `docker run --rm ...` Lambda dependency build.
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
