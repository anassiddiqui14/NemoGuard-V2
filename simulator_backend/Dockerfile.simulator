FROM python:3.10-slim

WORKDIR /app

# Build context is the repo root (see docker-compose.yml) so this image can
# also bundle localstack_lab/ -- the simulator's new /lab/* endpoints reuse
# its aws_clients.py factory and its exact bucket/function/queue naming
# conventions instead of re-implementing (and inevitably drifting from) a
# second copy of that logic.
COPY simulator_backend/ ./
COPY localstack_lab/ ./localstack_lab/

RUN pip install --no-cache-dir fastapi uvicorn pydantic httpx psycopg2-binary openai "boto3==1.34.144" "botocore==1.34.144"

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
